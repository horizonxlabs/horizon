:80 {
	# Don't compress /api/*: gzip/zstd buffer the response to compress it, which batches the chat
	# SSE tokens (text/event-stream under /api) into bursts instead of streaming them token-by-token
	# (the AI-typing UX). Everything else (HTML/CSS/JS/assets) is still compressed.
	@compressible not path /api/*
	encode @compressible zstd gzip

	@published_subdomain {
		host *.localhost
		header_regexp published Host ^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])?\.localhost(?::[0-9]+)?$
	}
	handle @published_subdomain {
		rewrite * /__subdomain{uri}
		reverse_proxy platform-api:3100 {
			header_up Host {http.request.host}
		}
	}

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	handle_path /api/* {
		# SSE: flush every write immediately so long AI generations stream without proxy timeouts.
		reverse_proxy platform-api:3100 {
			flush_interval -1
		}
	}

	redir /creator /creator/ 308
	redir /store /store/ 308

	handle /horizon-logo.png {
		rewrite * /creator/horizon-logo.png
		reverse_proxy creator-web:4101
	}

	handle /creator* {
		reverse_proxy creator-web:4101
	}

	handle /apps/* {
		reverse_proxy platform-api:3100
	}

	handle /store* {
		reverse_proxy app-store-pwa:4102
	}

	handle /preview/* {
		reverse_proxy platform-api:3100
	}

	handle {
		reverse_proxy admin-web:4100
	}
}
