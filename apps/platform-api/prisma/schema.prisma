generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
  invited
  suspended
}

enum ProjectStatus {
  draft
  active
  archived
}

enum AppStatus {
  draft
  published
  disabled
  archived
}

enum AuditSeverity {
  info
  warning
  high
  critical
}

enum AiProviderStatus {
  active
  disabled
  warning
  error
}

enum AiUsageMode {
  production
  development
  fallback
}

enum GuardrailDecision {
  allow
  warn
  block
}

enum GuardrailRuleType {
  keyword
  regex
  policy
}

model PlatformUser {
  id          String              @id
  email       String              @unique
  name        String
  status      UserStatus          @default(active)
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  passwordUpdatedAt  DateTime?
  groups      PlatformUserGroup[]
  roles       PlatformUserRole[]
  projects    Project[]           @relation("ProjectOwner")
  memberships ProjectMember[]
  appMembers  AppMember[]
  appInstallations AppInstallation[]
  appInvitationsSent AppInvitation[] @relation("AppInvitationInvitedBy")
  appAccessDecisions AppAccessRequest[] @relation("AppAccessRequestDecidedBy")
  publishRequests PublishRequest[] @relation("PublishRequestRequestedBy")
  deploymentRecords DeploymentRecord[] @relation("DeploymentRecordPublishedBy")
  ownedRegistryEntries AppStoreRegistryEntry[] @relation("AppStoreRegistryOwner")
  ticketsSubmitted SupportTicket[] @relation("SupportTicketSubmittedBy")
  ticketsAssigned SupportTicket[] @relation("SupportTicketAssignedTo")
  ticketTimelineEntries SupportTicketTimelineEntry[] @relation("SupportTicketTimelineActor")
  prdChangeRequests PrdChangeRequest[] @relation("PrdChangeRequestedBy")
  prdChangeDecisions PrdChangeDecision[] @relation("PrdChangeDecisionBy")
  domainRequests DomainRequest[] @relation("DomainRequestRequestedBy")
  domainRequestDecisions DomainRequest[] @relation("DomainRequestDecidedBy")
  authProviderConfigs AuthProviderConfig[] @relation("AuthProviderCreatedBy")
  platformAuthSessions PlatformAuthSession[] @relation("PlatformAuthSessionUser")
  breakGlassSessions BreakGlassSession[] @relation("BreakGlassSessionUser")
  policyTemplates PolicyTemplate[] @relation("PolicyTemplateCreatedBy")
  knowledgeSources KnowledgeSource[] @relation("KnowledgeSourceOwner")
  knowledgeVersions KnowledgeVersion[] @relation("KnowledgeVersionCreatedBy")
  knowledgeApprovals KnowledgeApproval[] @relation("KnowledgeApprovalDecidedBy")
  knowledgeRetrievalLogs KnowledgeRetrievalLog[] @relation("KnowledgeRetrievalActor")
  skillDefinitions SkillDefinition[] @relation("SkillDefinitionOwner")
  skillVersions SkillVersion[] @relation("SkillVersionCreatedBy")
  skillApprovals SkillApproval[] @relation("SkillApprovalDecidedBy")
  installerReports InstallerReport[] @relation("InstallerReportCreatedBy")
  setupConfigurations SetupConfiguration[] @relation("SetupConfigurationCreatedBy")
  backupPolicies BackupPolicy[] @relation("BackupPolicyCreatedBy")
  backupRuns BackupRun[] @relation("BackupRunCreatedBy")
  pitrConfigurations PitrConfiguration[] @relation("PitrConfigurationCreatedBy")
  restoreDrillReports RestoreDrillReport[] @relation("RestoreDrillCreatedBy")
  serviceHealthSnapshots ServiceHealthSnapshot[] @relation("ServiceHealthSnapshotCreatedBy")
  telemetryExportConfigs TelemetryExportConfig[] @relation("TelemetryExportConfigCreatedBy")
  upgradeCompatibilityReports UpgradeCompatibilityReport[] @relation("UpgradeCompatibilityReportCreatedBy")
  rollbackReports RollbackReport[] @relation("RollbackReportCreatedBy")
  licenseRecords LicenseRecord[] @relation("LicenseRecordCreatedBy")
  licenseValidationLogs LicenseValidationLog[] @relation("LicenseValidationLogCreatedBy")
  licenseEnforcementEvents LicenseEnforcementEvent[] @relation("LicenseEnforcementActor")
  securityReadinessReports SecurityReadinessReport[]
  securityReadinessChecks SecurityReadinessCheck[]
  uploadScanEvents UploadScanEvent[]
  releaseChecklistReports ReleaseChecklistReport[]
  sensitiveRedactionEvidence SensitiveRedactionEvidence[]
  notifications InAppNotification[]
  auditLogs   AuditLog[]
  guardrailEvents GuardrailEvent[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("platform_users")
}

model PlatformGroup {
  id        String              @id
  key       String              @unique
  name      String
  users     PlatformUserGroup[]
  createdAt DateTime            @default(now()) @map("created_at")

  @@map("platform_groups")
}

model PlatformRole {
  id          String             @id
  key         String             @unique
  name        String
  permissions String[]
  users       PlatformUserRole[]
  createdAt   DateTime           @default(now()) @map("created_at")

  @@map("platform_roles")
}

model PlatformUserGroup {
  userId  String        @map("user_id")
  groupId String        @map("group_id")
  user    PlatformUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   PlatformGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("platform_user_groups")
}

model PlatformUserRole {
  userId String       @map("user_id")
  roleId String       @map("role_id")
  user   PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("platform_user_roles")
}

model Project {
  id          String          @id
  name        String
  status      ProjectStatus   @default(draft)
  ownerUserId String          @map("owner_user_id")
  appType     String?         @map("app_type")
  businessProblem String?     @map("business_problem")
  targetDepartment String?    @map("target_department")
  intendedUsers String[]      @default([]) @map("intended_users")
  dataSensitivity String?     @map("data_sensitivity")
  activeFrontendCheckpointId String? @map("active_frontend_checkpoint_id")
  owner       PlatformUser    @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  members     ProjectMember[]
  apps        App[]
  prdDocument PrdDocument?
  workspaceTasks WorkspaceTask[]
  previewVersions PreviewVersion[]
  aiUsageLogs AiUsageLog[]
  appDatabaseTables AppDatabaseTable[]
  appDatabaseRelationships AppDatabaseRelationship[]
  appDatabaseSampleRecords AppDatabaseSampleRecord[]
  appDatabaseMigrations AppDatabaseMigration[]
  frontendCheckpoints FrontendCheckpoint[]
  workspaceMigrationRecords WorkspaceMigrationRecord[]
  workspaceRuntimeRecord WorkspaceRuntimeRecord?
  appInvitations AppInvitation[]
  appAccessRequests AppAccessRequest[]
  appManifests AppManifest[]
  publishRequests PublishRequest[]
  deploymentRecords DeploymentRecord[]
  appStoreRegistryEntries AppStoreRegistryEntry[]
  generatedAppRuntimes GeneratedAppRuntime[]
  supportTickets SupportTicket[]
  prdChangeRequests PrdChangeRequest[]
  domainSetting DomainSetting?
  domainRequests DomainRequest[]
  deploymentTraceRecords DeploymentTraceRecord[]
  knowledgeSources KnowledgeSource[]
  knowledgeRetrievalLogs KnowledgeRetrievalLog[]
  skillAssignments SkillAssignment[]
  notifications InAppNotification[]
  chatMessages ChatMessage[]
  chatSummary ChatSummary?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectMember {
  projectId String       @map("project_id")
  userId    String       @map("user_id")
  role      String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model App {
  id                 String      @id
  slug               String      @unique
  name               String
  status             AppStatus   @default(draft)
  projectId          String      @map("project_id")
  databaseSchemaName String?     @unique @map("database_schema_name")
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roles              AppRole[]
  members            AppMember[]
  appInstallations   AppInstallation[]
  invitations        AppInvitation[]
  accessRequests     AppAccessRequest[]
  manifest           AppManifest?
  publishRequests    PublishRequest[]
  deploymentRecords  DeploymentRecord[]
  registryEntry      AppStoreRegistryEntry?
  generatedAppRuntimes GeneratedAppRuntime[]
  supportTickets     SupportTicket[]
  knowledgeSources   KnowledgeSource[]
  knowledgeRetrievalLogs KnowledgeRetrievalLog[]
  skillAssignments   SkillAssignment[]
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("apps")
}

model AppRole {
  id          String      @id
  appId       String      @map("app_id")
  key         String
  name        String
  permissions String[]
  app         App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  members     AppMember[]

  @@unique([appId, key])
  @@map("app_roles")
}

model AppMember {
  appId  String       @map("app_id")
  userId String       @map("user_id")
  roleId String       @map("role_id")
  app    App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  user   PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   AppRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([appId, userId, roleId])
  @@map("app_members")
}

model AppInstallation {
  id           String       @id
  appId        String       @map("app_id")
  userId       String       @map("user_id")
  status       String
  installedAt  DateTime     @default(now()) @map("installed_at")
  disabledAt   DateTime?    @map("disabled_at")
  lastOpenedAt DateTime?    @map("last_opened_at")
  app          App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  user         PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, userId])
  @@index([userId, status])
  @@map("app_installations")
}

model AuditLog {
  id           String        @id
  actorUserId  String        @map("actor_user_id")
  action       String
  resourceType String        @map("resource_type")
  resourceId   String        @map("resource_id")
  severity     AuditSeverity @default(info)
  metadata     Json          @default("{}")
  requestId    String?       @map("request_id")
  previousHash String?       @map("previous_hash")
  recordHash   String?       @map("record_hash")
  occurredAt   DateTime      @default(now()) @map("occurred_at")
  actor        PlatformUser  @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model AiProvider {
  id        String           @id
  name      String
  adapter   String
  baseUrl   String           @map("base_url")
  models    String[]
  status    AiProviderStatus @default(active)
  apiKeys   AiApiKey[]
  routes    AiScenarioRoute[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("ai_providers")
}

model AiApiKey {
  id                 String       @id
  providerId         String       @map("provider_id")
  name               String
  usageMode          AiUsageMode  @map("usage_mode")
  quotaTokens        Int          @map("quota_tokens")
  fallbackPriority   Int          @map("fallback_priority")
  fingerprint        String
  maskedValue        String       @map("masked_value")
  secretCiphertext   String       @map("secret_ciphertext")
  keyVersion         Int          @default(1) @map("key_version")
  encryptionProvider String       @map("encryption_provider")
  status             String       @default("active")
  lastUsedAt         DateTime?    @map("last_used_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  provider           AiProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("ai_api_keys")
}

model AiScenarioRoute {
  id                 String     @id
  scenario           String     @unique
  primaryProviderId  String     @map("primary_provider_id")
  primaryModel       String     @map("primary_model")
  fallbackProviderId String?    @map("fallback_provider_id")
  fallbackModel      String?    @map("fallback_model")
  provider           AiProvider @relation(fields: [primaryProviderId], references: [id])
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@map("ai_scenario_routes")
}

model AiQuota {
  id               String   @id
  scope            String   @unique
  dailyLimit       Int      @map("daily_limit")
  monthlyLimit     Int      @map("monthly_limit")
  warningThreshold Int      @map("warning_threshold")
  hardStop         Boolean  @default(true) @map("hard_stop")
  usedToday        Int      @default(0) @map("used_today")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("ai_quotas")
}

model AiQuotaUsage {
  id        String   @id
  scope     String
  scopeId   String   @map("scope_id")
  usedToday Int      @default(0) @map("used_today")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scope, scopeId])
  @@map("ai_quota_usage")
}

model AiExecutionEvidence {
  id                  String   @id
  requestId           String   @unique @map("request_id")
  actorUserId         String   @map("actor_user_id")
  projectId           String?  @map("project_id")
  scenario            String
  providerId          String   @map("provider_id")
  model               String
  status              String
  tokensUsed          Int      @map("tokens_used")
  latencyMs           Int      @map("latency_ms")
  fallbackUsed        Boolean  @default(false) @map("fallback_used")
  failureReason       String?  @map("failure_reason")
  quotaScope          String   @map("quota_scope")
  quotaTokensReserved Int      @default(0) @map("quota_tokens_reserved")
  occurredAt          DateTime @default(now()) @map("occurred_at")

  @@index([projectId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("ai_execution_evidence")
}

model GuardrailRule {
  id        String            @id
  name      String
  type      GuardrailRuleType
  pattern   String
  severity  AuditSeverity
  action    GuardrailDecision
  scope     String
  status    String            @default("active")
  events    GuardrailEvent[]
  updatedAt DateTime          @updatedAt @map("updated_at")
  createdAt DateTime          @default(now()) @map("created_at")

  @@map("guardrail_rules")
}

model GuardrailEvent {
  id              String            @id
  actorUserId     String            @map("actor_user_id")
  prompt          String
  scenario        String
  decision        GuardrailDecision
  matchedRuleId   String?           @map("matched_rule_id")
  matchedRuleName String?           @map("matched_rule_name")
  severity        AuditSeverity
  occurredAt      DateTime          @default(now()) @map("occurred_at")
  actor           PlatformUser      @relation(fields: [actorUserId], references: [id])
  matchedRule     GuardrailRule?    @relation(fields: [matchedRuleId], references: [id])

  @@index([actorUserId, occurredAt])
  @@index([decision])
  @@map("guardrail_events")
}

model PrdDocument {
  id                String       @id
  projectId         String       @unique @map("project_id")
  status            String       @default("draft")
  currentVersionId  String?      @map("current_version_id")
  baselineVersionId String?      @map("baseline_version_id")
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions          PrdVersion[] @relation("PrdDocumentVersions")
  currentVersion    PrdVersion?  @relation("PrdCurrentVersion", fields: [currentVersionId], references: [id])
  baselineVersion   PrdVersion?  @relation("PrdBaselineVersion", fields: [baselineVersionId], references: [id])
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("prd_documents")
}

model PrdVersion {
  id              String        @id
  documentId      String        @map("document_id")
  version         String
  status          String
  isBaseline      Boolean       @default(false) @map("is_baseline")
  sourcePrompt    String        @map("source_prompt")
  changeSummary   String        @map("change_summary")
  generatedBy     Json          @default("{}") @map("generated_by")
  createdByUserId String        @map("created_by_user_id")
  document        PrdDocument   @relation("PrdDocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor      PrdDocument[] @relation("PrdCurrentVersion")
  baselineFor     PrdDocument[] @relation("PrdBaselineVersion")
  sections        PrdSection[]
  approvedChangeRequests PrdChangeRequest[] @relation("PrdChangeApprovedVersion")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([documentId])
  @@map("prd_versions")
}

model PrdSection {
  id        String     @id
  versionId String     @map("version_id")
  key       String
  title     String
  body      String
  order     Int
  version   PrdVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@map("prd_sections")
}

model WorkspaceTask {
  id                String              @id
  projectId         String              @map("project_id")
  prompt            String
  status            String
  guardrailDecision String              @map("guardrail_decision")
  guardrailEventId  String              @map("guardrail_event_id")
  knowledgeVersionIds String[]          @default([]) @map("knowledge_version_ids")
  skillVersionId    String?             @map("skill_version_id")
  createdByUserId   String              @map("created_by_user_id")
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps             WorkspaceTaskStep[]
  usageLogs         AiUsageLog[]
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("workspace_tasks")
}

model WorkspaceTaskStep {
  id      String        @id
  taskId  String        @map("task_id")
  label   String
  status  String
  order   Int
  task    WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, order])
  @@map("workspace_task_steps")
}

model PreviewVersion {
  id          String   @id
  projectId   String   @map("project_id")
  version     String
  summary     String
  device      String
  screenTitle String   @map("screen_title")
  highlights  String[]
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([projectId, version])
  @@map("preview_versions")
}

model AiUsageLog {
  id         String        @id
  projectId  String        @map("project_id")
  taskId     String        @map("task_id")
  actorUserId String       @map("actor_user_id")
  scenario   String
  providerId String        @map("provider_id")
  model      String
  prompt     String
  tokensUsed Int           @map("tokens_used")
  knowledgeVersionIds String[] @default([]) @map("knowledge_version_ids")
  skillVersionId String? @map("skill_version_id")
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  occurredAt DateTime      @default(now()) @map("occurred_at")

  @@index([projectId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("ai_usage_logs")
}

model AppDatabaseTable {
  id          String              @id
  projectId   String              @map("project_id")
  key         String
  displayName String              @map("display_name")
  description String
  source      String              @default("generated")
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns     AppDatabaseColumn[]
  sampleRecords AppDatabaseSampleRecord[]
  createdAt   DateTime            @default(now()) @map("created_at")

  @@unique([projectId, key])
  @@map("app_database_tables")
}

model AppDatabaseColumn {
  id           String           @id
  tableId      String           @map("table_id")
  name         String
  dataType     String           @map("data_type")
  required     Boolean          @default(false)
  defaultValue String?          @map("default_value")
  source       String           @default("generated")
  order        Int
  table        AppDatabaseTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, name])
  @@map("app_database_columns")
}

model AppDatabaseRelationship {
  id           String   @id
  projectId    String   @map("project_id")
  sourceTable  String   @map("source_table")
  sourceColumn String   @map("source_column")
  targetTable  String   @map("target_table")
  targetColumn String   @map("target_column")
  cardinality  String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("app_database_relationships")
}

model AppDatabaseSampleRecord {
  id        String           @id
  projectId String           @map("project_id")
  tableId   String           @map("table_id")
  tableKey  String           @map("table_key")
  ordinal   Int
  data      Json
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  table     AppDatabaseTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, ordinal])
  @@index([projectId])
  @@map("app_database_sample_records")
}

model AppDatabaseMigration {
  id                         String   @id
  projectId                  String   @map("project_id")
  migrationId                String   @map("migration_id")
  status                     String
  createdByUserId            String   @map("created_by_user_id")
  linkedPrdVersion           String   @map("linked_prd_version")
  linkedFrontendCheckpoint   String?  @map("linked_frontend_checkpoint")
  appliedAt                  DateTime @map("applied_at")
  project                    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, migrationId])
  @@map("app_database_migrations")
}

model FrontendCheckpoint {
  id                        String   @id
  projectId                 String   @map("project_id")
  version                   String
  sourcePreviewVersion      String   @map("source_preview_version")
  sourceTaskId              String?  @map("source_task_id")
  status                    String
  checksum                  String
  fileManifest              Json     @map("file_manifest")
  routeSnapshot             Json     @map("route_snapshot")
  changeSummary             String   @map("change_summary")
  changedAreas              String[] @default([]) @map("changed_areas")
  createdByUserId           String   @map("created_by_user_id")
  restoreSourceCheckpointId String?  @map("restore_source_checkpoint_id")
  project                   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt                 DateTime @default(now()) @map("created_at")

  @@unique([projectId, version])
  @@index([projectId, status])
  @@map("frontend_checkpoints")
}

/** Applied SQL emitted by the Creator generation loop; independent from app-schema design rows. */
model WorkspaceMigrationRecord {
  id        String   @id
  projectId String   @map("project_id")
  name      String
  sql       String
  commitSha String   @map("commit_sha")
  appliedAt DateTime @map("applied_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, appliedAt])
  @@map("workspace_migration_records")
}

/** Intended lifecycle state for a managed development workspace; never stores secret values. */
model WorkspaceRuntimeRecord {
  id                String   @id
  projectId         String   @unique @map("project_id")
  slug              String
  state             String
  containerId       String?  @map("container_id")
  cpuCores          Int      @map("cpu_cores")
  memoryMb          Int      @map("memory_mb")
  llmGatewayKeyId   String?  @map("llm_gateway_key_id")
  lastActivityAt    DateTime @map("last_activity_at")
  lastError         String?  @map("last_error")
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([state, lastActivityAt])
  @@map("workspace_runtime_records")
}

model ChatMessage {
  id                String   @id
  projectId         String   @map("project_id")
  role              String
  agentMode         String?  @map("agent_mode")
  content           String
  artifactActionIds String[] @default([]) @map("artifact_action_ids")
  actions           Json?
  commitSha         String?  @map("commit_sha")
  tokenUsage        Json?    @map("token_usage")
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("chat_messages")
}

model ChatSummary {
  projectId String   @id @map("project_id")
  summary   String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_summaries")
}

model AppInvitation {
  id              String   @id
  appId           String   @map("app_id")
  projectId       String   @map("project_id")
  email           String
  userType        String   @map("user_type")
  roleKey         String   @map("role_key")
  invitedByUserId String   @map("invited_by_user_id")
  status          String
  policyWarning   String?  @map("policy_warning")
  expiresAt       DateTime? @map("expires_at")
  note            String?
  app             App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
