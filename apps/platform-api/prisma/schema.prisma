generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
  invited
  suspended
}

enum ProjectStatus {
  draft
  active
  archived
}

enum AppStatus {
  draft
  published
  disabled
  archived
}

enum AuditSeverity {
  info
  warning
  high
  critical
}

enum AiProviderStatus {
  active
  disabled
  warning
  error
}

enum AiUsageMode {
  production
  development
  fallback
}

enum GuardrailDecision {
  allow
  warn
  block
}

enum GuardrailRuleType {
  keyword
  regex
  policy
}

model PlatformUser {
  id          String              @id
  email       String              @unique
  name        String
  status      UserStatus          @default(active)
  groups      PlatformUserGroup[]
  roles       PlatformUserRole[]
  projects    Project[]           @relation("ProjectOwner")
  memberships ProjectMember[]
  appMembers  AppMember[]
  auditLogs   AuditLog[]
  guardrailEvents GuardrailEvent[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("platform_users")
}

model PlatformGroup {
  id        String              @id
  key       String              @unique
  name      String
  users     PlatformUserGroup[]
  createdAt DateTime            @default(now()) @map("created_at")

  @@map("platform_groups")
}

model PlatformRole {
  id          String             @id
  key         String             @unique
  name        String
  permissions String[]
  users       PlatformUserRole[]
  createdAt   DateTime           @default(now()) @map("created_at")

  @@map("platform_roles")
}

model PlatformUserGroup {
  userId  String        @map("user_id")
  groupId String        @map("group_id")
  user    PlatformUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   PlatformGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("platform_user_groups")
}

model PlatformUserRole {
  userId String       @map("user_id")
  roleId String       @map("role_id")
  user   PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("platform_user_roles")
}

model Project {
  id          String          @id
  slug        String          @unique
  name        String
  status      ProjectStatus   @default(draft)
  ownerUserId String          @map("owner_user_id")
  owner       PlatformUser    @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  members     ProjectMember[]
  apps        App[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectMember {
  projectId String       @map("project_id")
  userId    String       @map("user_id")
  role      String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model App {
  id                 String      @id
  slug               String      @unique
  name               String
  status             AppStatus   @default(draft)
  projectId          String      @map("project_id")
  databaseSchemaName String?     @unique @map("database_schema_name")
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roles              AppRole[]
  members            AppMember[]
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("apps")
}

model AppRole {
  id          String      @id
  appId       String      @map("app_id")
  key         String
  name        String
  permissions String[]
  app         App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  members     AppMember[]

  @@unique([appId, key])
  @@map("app_roles")
}

model AppMember {
  appId  String       @map("app_id")
  userId String       @map("user_id")
  roleId String       @map("role_id")
  app    App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  user   PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   AppRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([appId, userId, roleId])
  @@map("app_members")
}

model AuditLog {
  id           String        @id
  actorUserId  String        @map("actor_user_id")
  action       String
  resourceType String        @map("resource_type")
  resourceId   String        @map("resource_id")
  severity     AuditSeverity @default(info)
  metadata     Json          @default("{}")
  requestId    String?       @map("request_id")
  previousHash String?       @map("previous_hash")
  recordHash   String?       @map("record_hash")
  occurredAt   DateTime      @default(now()) @map("occurred_at")
  actor        PlatformUser  @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model AiProvider {
  id        String           @id
  name      String
  adapter   String
  baseUrl   String           @map("base_url")
  models    String[]
  status    AiProviderStatus @default(active)
  apiKeys   AiApiKey[]
  routes    AiScenarioRoute[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("ai_providers")
}

model AiApiKey {
  id                 String       @id
  providerId         String       @map("provider_id")
  name               String
  usageMode          AiUsageMode  @map("usage_mode")
  quotaTokens        Int          @map("quota_tokens")
  fallbackPriority   Int          @map("fallback_priority")
  fingerprint        String
  maskedValue        String       @map("masked_value")
  secretCiphertext   String       @map("secret_ciphertext")
  keyVersion         Int          @default(1) @map("key_version")
  encryptionProvider String       @map("encryption_provider")
  status             String       @default("active")
  lastUsedAt         DateTime?    @map("last_used_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  provider           AiProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("ai_api_keys")
}

model AiScenarioRoute {
  id                 String     @id
  scenario           String     @unique
  primaryProviderId  String     @map("primary_provider_id")
  primaryModel       String     @map("primary_model")
  fallbackProviderId String?    @map("fallback_provider_id")
  fallbackModel      String?    @map("fallback_model")
  provider           AiProvider @relation(fields: [primaryProviderId], references: [id])
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@map("ai_scenario_routes")
}

model AiQuota {
  id               String   @id
  scope            String   @unique
  dailyLimit       Int      @map("daily_limit")
  monthlyLimit     Int      @map("monthly_limit")
  warningThreshold Int      @map("warning_threshold")
  hardStop         Boolean  @default(true) @map("hard_stop")
  usedToday        Int      @default(0) @map("used_today")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("ai_quotas")
}

model GuardrailRule {
  id        String            @id
  name      String
  type      GuardrailRuleType
  pattern   String
  severity  AuditSeverity
  action    GuardrailDecision
  scope     String
  status    String            @default("active")
  events    GuardrailEvent[]
  updatedAt DateTime          @updatedAt @map("updated_at")
  createdAt DateTime          @default(now()) @map("created_at")

  @@map("guardrail_rules")
}

model GuardrailEvent {
  id              String            @id
  actorUserId     String            @map("actor_user_id")
  prompt          String
  scenario        String
  decision        GuardrailDecision
  matchedRuleId   String?           @map("matched_rule_id")
  matchedRuleName String?           @map("matched_rule_name")
  severity        AuditSeverity
  occurredAt      DateTime          @default(now()) @map("occurred_at")
  actor           PlatformUser      @relation(fields: [actorUserId], references: [id])
  matchedRule     GuardrailRule?    @relation(fields: [matchedRuleId], references: [id])

  @@index([actorUserId, occurredAt])
  @@index([decision])
  @@map("guardrail_events")
}
