generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
  invited
  suspended
}

enum ProjectStatus {
  draft
  active
  archived
}

enum AppStatus {
  draft
  published
  disabled
  archived
}

enum AuditSeverity {
  info
  warning
  high
  critical
}

enum AiProviderStatus {
  active
  disabled
  warning
  error
}

enum AiUsageMode {
  production
  development
  fallback
}

enum GuardrailDecision {
  allow
  warn
  block
}

enum GuardrailRuleType {
  keyword
  regex
  policy
}

model PlatformUser {
  id          String              @id
  email       String              @unique
  name        String
  status      UserStatus          @default(active)
  groups      PlatformUserGroup[]
  roles       PlatformUserRole[]
  projects    Project[]           @relation("ProjectOwner")
  memberships ProjectMember[]
  appMembers  AppMember[]
  appInvitationsSent AppInvitation[] @relation("AppInvitationInvitedBy")
  appAccessDecisions AppAccessRequest[] @relation("AppAccessRequestDecidedBy")
  publishRequests PublishRequest[] @relation("PublishRequestRequestedBy")
  deploymentRecords DeploymentRecord[] @relation("DeploymentRecordPublishedBy")
  ownedRegistryEntries AppStoreRegistryEntry[] @relation("AppStoreRegistryOwner")
  ticketsSubmitted SupportTicket[] @relation("SupportTicketSubmittedBy")
  ticketsAssigned SupportTicket[] @relation("SupportTicketAssignedTo")
  ticketTimelineEntries SupportTicketTimelineEntry[] @relation("SupportTicketTimelineActor")
  prdChangeRequests PrdChangeRequest[] @relation("PrdChangeRequestedBy")
  prdChangeDecisions PrdChangeDecision[] @relation("PrdChangeDecisionBy")
  domainRequests DomainRequest[] @relation("DomainRequestRequestedBy")
  domainRequestDecisions DomainRequest[] @relation("DomainRequestDecidedBy")
  notifications InAppNotification[]
  auditLogs   AuditLog[]
  guardrailEvents GuardrailEvent[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("platform_users")
}

model PlatformGroup {
  id        String              @id
  key       String              @unique
  name      String
  users     PlatformUserGroup[]
  createdAt DateTime            @default(now()) @map("created_at")

  @@map("platform_groups")
}

model PlatformRole {
  id          String             @id
  key         String             @unique
  name        String
  permissions String[]
  users       PlatformUserRole[]
  createdAt   DateTime           @default(now()) @map("created_at")

  @@map("platform_roles")
}

model PlatformUserGroup {
  userId  String        @map("user_id")
  groupId String        @map("group_id")
  user    PlatformUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   PlatformGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("platform_user_groups")
}

model PlatformUserRole {
  userId String       @map("user_id")
  roleId String       @map("role_id")
  user   PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("platform_user_roles")
}

model Project {
  id          String          @id
  slug        String          @unique
  name        String
  status      ProjectStatus   @default(draft)
  ownerUserId String          @map("owner_user_id")
  appType     String?         @map("app_type")
  businessProblem String?     @map("business_problem")
  targetDepartment String?    @map("target_department")
  intendedUsers String[]      @default([]) @map("intended_users")
  dataSensitivity String?     @map("data_sensitivity")
  activeFrontendCheckpointId String? @map("active_frontend_checkpoint_id")
  owner       PlatformUser    @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  members     ProjectMember[]
  apps        App[]
  prdDocument PrdDocument?
  workspaceTasks WorkspaceTask[]
  previewVersions PreviewVersion[]
  aiUsageLogs AiUsageLog[]
  appDatabaseTables AppDatabaseTable[]
  appDatabaseRelationships AppDatabaseRelationship[]
  appDatabaseSampleRecords AppDatabaseSampleRecord[]
  appDatabaseMigrations AppDatabaseMigration[]
  frontendCheckpoints FrontendCheckpoint[]
  appInvitations AppInvitation[]
  appAccessRequests AppAccessRequest[]
  appManifests AppManifest[]
  publishRequests PublishRequest[]
  deploymentRecords DeploymentRecord[]
  appStoreRegistryEntries AppStoreRegistryEntry[]
  supportTickets SupportTicket[]
  prdChangeRequests PrdChangeRequest[]
  domainSetting DomainSetting?
  domainRequests DomainRequest[]
  deploymentTraceRecords DeploymentTraceRecord[]
  notifications InAppNotification[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectMember {
  projectId String       @map("project_id")
  userId    String       @map("user_id")
  role      String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model App {
  id                 String      @id
  slug               String      @unique
  name               String
  status             AppStatus   @default(draft)
  projectId          String      @map("project_id")
  databaseSchemaName String?     @unique @map("database_schema_name")
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roles              AppRole[]
  members            AppMember[]
  invitations        AppInvitation[]
  accessRequests     AppAccessRequest[]
  manifest           AppManifest?
  publishRequests    PublishRequest[]
  deploymentRecords  DeploymentRecord[]
  registryEntry      AppStoreRegistryEntry?
  supportTickets     SupportTicket[]
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("apps")
}

model AppRole {
  id          String      @id
  appId       String      @map("app_id")
  key         String
  name        String
  permissions String[]
  app         App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  members     AppMember[]

  @@unique([appId, key])
  @@map("app_roles")
}

model AppMember {
  appId  String       @map("app_id")
  userId String       @map("user_id")
  roleId String       @map("role_id")
  app    App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  user   PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   AppRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([appId, userId, roleId])
  @@map("app_members")
}

model AuditLog {
  id           String        @id
  actorUserId  String        @map("actor_user_id")
  action       String
  resourceType String        @map("resource_type")
  resourceId   String        @map("resource_id")
  severity     AuditSeverity @default(info)
  metadata     Json          @default("{}")
  requestId    String?       @map("request_id")
  previousHash String?       @map("previous_hash")
  recordHash   String?       @map("record_hash")
  occurredAt   DateTime      @default(now()) @map("occurred_at")
  actor        PlatformUser  @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model AiProvider {
  id        String           @id
  name      String
  adapter   String
  baseUrl   String           @map("base_url")
  models    String[]
  status    AiProviderStatus @default(active)
  apiKeys   AiApiKey[]
  routes    AiScenarioRoute[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("ai_providers")
}

model AiApiKey {
  id                 String       @id
  providerId         String       @map("provider_id")
  name               String
  usageMode          AiUsageMode  @map("usage_mode")
  quotaTokens        Int          @map("quota_tokens")
  fallbackPriority   Int          @map("fallback_priority")
  fingerprint        String
  maskedValue        String       @map("masked_value")
  secretCiphertext   String       @map("secret_ciphertext")
  keyVersion         Int          @default(1) @map("key_version")
  encryptionProvider String       @map("encryption_provider")
  status             String       @default("active")
  lastUsedAt         DateTime?    @map("last_used_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  provider           AiProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("ai_api_keys")
}

model AiScenarioRoute {
  id                 String     @id
  scenario           String     @unique
  primaryProviderId  String     @map("primary_provider_id")
  primaryModel       String     @map("primary_model")
  fallbackProviderId String?    @map("fallback_provider_id")
  fallbackModel      String?    @map("fallback_model")
  provider           AiProvider @relation(fields: [primaryProviderId], references: [id])
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@map("ai_scenario_routes")
}

model AiQuota {
  id               String   @id
  scope            String   @unique
  dailyLimit       Int      @map("daily_limit")
  monthlyLimit     Int      @map("monthly_limit")
  warningThreshold Int      @map("warning_threshold")
  hardStop         Boolean  @default(true) @map("hard_stop")
  usedToday        Int      @default(0) @map("used_today")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("ai_quotas")
}

model GuardrailRule {
  id        String            @id
  name      String
  type      GuardrailRuleType
  pattern   String
  severity  AuditSeverity
  action    GuardrailDecision
  scope     String
  status    String            @default("active")
  events    GuardrailEvent[]
  updatedAt DateTime          @updatedAt @map("updated_at")
  createdAt DateTime          @default(now()) @map("created_at")

  @@map("guardrail_rules")
}

model GuardrailEvent {
  id              String            @id
  actorUserId     String            @map("actor_user_id")
  prompt          String
  scenario        String
  decision        GuardrailDecision
  matchedRuleId   String?           @map("matched_rule_id")
  matchedRuleName String?           @map("matched_rule_name")
  severity        AuditSeverity
  occurredAt      DateTime          @default(now()) @map("occurred_at")
  actor           PlatformUser      @relation(fields: [actorUserId], references: [id])
  matchedRule     GuardrailRule?    @relation(fields: [matchedRuleId], references: [id])

  @@index([actorUserId, occurredAt])
  @@index([decision])
  @@map("guardrail_events")
}

model PrdDocument {
  id                String       @id
  projectId         String       @unique @map("project_id")
  status            String       @default("draft")
  currentVersionId  String?      @map("current_version_id")
  baselineVersionId String?      @map("baseline_version_id")
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions          PrdVersion[] @relation("PrdDocumentVersions")
  currentVersion    PrdVersion?  @relation("PrdCurrentVersion", fields: [currentVersionId], references: [id])
  baselineVersion   PrdVersion?  @relation("PrdBaselineVersion", fields: [baselineVersionId], references: [id])
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("prd_documents")
}

model PrdVersion {
  id              String        @id
  documentId      String        @map("document_id")
  version         String
  status          String
  isBaseline      Boolean       @default(false) @map("is_baseline")
  sourcePrompt    String        @map("source_prompt")
  changeSummary   String        @map("change_summary")
  generatedBy     Json          @default("{}") @map("generated_by")
  createdByUserId String        @map("created_by_user_id")
  document        PrdDocument   @relation("PrdDocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor      PrdDocument[] @relation("PrdCurrentVersion")
  baselineFor     PrdDocument[] @relation("PrdBaselineVersion")
  sections        PrdSection[]
  approvedChangeRequests PrdChangeRequest[] @relation("PrdChangeApprovedVersion")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([documentId])
  @@map("prd_versions")
}

model PrdSection {
  id        String     @id
  versionId String     @map("version_id")
  key       String
  title     String
  body      String
  order     Int
  version   PrdVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@map("prd_sections")
}

model WorkspaceTask {
  id                String              @id
  projectId         String              @map("project_id")
  prompt            String
  status            String
  guardrailDecision String              @map("guardrail_decision")
  guardrailEventId  String              @map("guardrail_event_id")
  createdByUserId   String              @map("created_by_user_id")
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps             WorkspaceTaskStep[]
  usageLogs         AiUsageLog[]
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("workspace_tasks")
}

model WorkspaceTaskStep {
  id      String        @id
  taskId  String        @map("task_id")
  label   String
  status  String
  order   Int
  task    WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, order])
  @@map("workspace_task_steps")
}

model PreviewVersion {
  id          String   @id
  projectId   String   @map("project_id")
  version     String
  summary     String
  device      String
  screenTitle String   @map("screen_title")
  highlights  String[]
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([projectId, version])
  @@map("preview_versions")
}

model AiUsageLog {
  id         String        @id
  projectId  String        @map("project_id")
  taskId     String        @map("task_id")
  actorUserId String       @map("actor_user_id")
  scenario   String
  providerId String        @map("provider_id")
  model      String
  prompt     String
  tokensUsed Int           @map("tokens_used")
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       WorkspaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  occurredAt DateTime      @default(now()) @map("occurred_at")

  @@index([projectId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("ai_usage_logs")
}

model AppDatabaseTable {
  id          String              @id
  projectId   String              @map("project_id")
  key         String
  displayName String              @map("display_name")
  description String
  source      String              @default("generated")
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns     AppDatabaseColumn[]
  sampleRecords AppDatabaseSampleRecord[]
  createdAt   DateTime            @default(now()) @map("created_at")

  @@unique([projectId, key])
  @@map("app_database_tables")
}

model AppDatabaseColumn {
  id           String           @id
  tableId      String           @map("table_id")
  name         String
  dataType     String           @map("data_type")
  required     Boolean          @default(false)
  defaultValue String?          @map("default_value")
  source       String           @default("generated")
  order        Int
  table        AppDatabaseTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, name])
  @@map("app_database_columns")
}

model AppDatabaseRelationship {
  id           String   @id
  projectId    String   @map("project_id")
  sourceTable  String   @map("source_table")
  sourceColumn String   @map("source_column")
  targetTable  String   @map("target_table")
  targetColumn String   @map("target_column")
  cardinality  String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("app_database_relationships")
}

model AppDatabaseSampleRecord {
  id        String           @id
  projectId String           @map("project_id")
  tableId   String           @map("table_id")
  tableKey  String           @map("table_key")
  ordinal   Int
  data      Json
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  table     AppDatabaseTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, ordinal])
  @@index([projectId])
  @@map("app_database_sample_records")
}

model AppDatabaseMigration {
  id                         String   @id
  projectId                  String   @map("project_id")
  migrationId                String   @map("migration_id")
  status                     String
  createdByUserId            String   @map("created_by_user_id")
  linkedPrdVersion           String   @map("linked_prd_version")
  linkedFrontendCheckpoint   String?  @map("linked_frontend_checkpoint")
  appliedAt                  DateTime @map("applied_at")
  project                    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, migrationId])
  @@map("app_database_migrations")
}

model FrontendCheckpoint {
  id                        String   @id
  projectId                 String   @map("project_id")
  version                   String
  sourcePreviewVersion      String   @map("source_preview_version")
  sourceTaskId              String?  @map("source_task_id")
  status                    String
  checksum                  String
  fileManifest              Json     @map("file_manifest")
  routeSnapshot             Json     @map("route_snapshot")
  changeSummary             String   @map("change_summary")
  changedAreas              String[] @default([]) @map("changed_areas")
  createdByUserId           String   @map("created_by_user_id")
  restoreSourceCheckpointId String?  @map("restore_source_checkpoint_id")
  project                   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt                 DateTime @default(now()) @map("created_at")

  @@unique([projectId, version])
  @@index([projectId, status])
  @@map("frontend_checkpoints")
}

model AppInvitation {
  id              String   @id
  appId           String   @map("app_id")
  projectId       String   @map("project_id")
  email           String
  userType        String   @map("user_type")
  roleKey         String   @map("role_key")
  invitedByUserId String   @map("invited_by_user_id")
  status          String
  policyWarning   String?  @map("policy_warning")
  expiresAt       DateTime? @map("expires_at")
  note            String?
  app             App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy       PlatformUser @relation("AppInvitationInvitedBy", fields: [invitedByUserId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([appId, status])
  @@index([projectId])
  @@map("app_invitations")
}

model AppAccessRequest {
  id               String   @id
  appId            String   @map("app_id")
  projectId        String   @map("project_id")
  requesterEmail   String   @map("requester_email")
  requestedRoleKey String   @map("requested_role_key")
  reason           String
  status           String
  decidedByUserId  String?  @map("decided_by_user_id")
  decidedAt        DateTime? @map("decided_at")
  app              App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decidedBy        PlatformUser? @relation("AppAccessRequestDecidedBy", fields: [decidedByUserId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([appId, status])
  @@index([projectId])
  @@map("app_access_requests")
}

model AppManifest {
  id                   String   @id
  appId                String   @unique @map("app_id")
  projectId            String   @map("project_id")
  manifestVersion      String   @map("manifest_version")
  prdVersionId         String   @map("prd_version_id")
  prdVersion           String   @map("prd_version")
  frontendCheckpointId String   @map("frontend_checkpoint_id")
  route                String
  authMode             String   @map("auth_mode")
  roleSnapshot         Json     @map("role_snapshot")
  databaseSnapshot     Json     @map("database_snapshot")
  manifest             Json
  app                  App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedAt          DateTime @default(now()) @map("generated_at")

  @@index([projectId])
  @@map("app_manifests")
}

model PublishRequest {
  id              String   @id
  appId           String   @map("app_id")
  projectId       String   @map("project_id")
  status          String
  requestedByUserId String @map("requested_by_user_id")
  manifestVersion String  @map("manifest_version")
  blockingItems   Json    @default("[]") @map("blocking_items")
  app             App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy     PlatformUser @relation("PublishRequestRequestedBy", fields: [requestedByUserId], references: [id])
  deploymentRecord DeploymentRecord?
  createdAt       DateTime @default(now()) @map("created_at")
  publishedAt     DateTime? @map("published_at")

  @@index([appId, status])
  @@index([projectId])
  @@map("publish_requests")
}

model DeploymentRecord {
  id                   String   @id
  appId                String   @map("app_id")
  projectId            String   @map("project_id")
  publishRequestId     String   @unique @map("publish_request_id")
  status               String
  environment          String
  route                String
  manifestVersion      String   @map("manifest_version")
  prdVersion           String   @map("prd_version")
  frontendCheckpointId String   @map("frontend_checkpoint_id")
  publishedByUserId    String   @map("published_by_user_id")
  app                  App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publishRequest       PublishRequest @relation(fields: [publishRequestId], references: [id], onDelete: Cascade)
  publishedBy          PlatformUser @relation("DeploymentRecordPublishedBy", fields: [publishedByUserId], references: [id])
  registryEntry        AppStoreRegistryEntry?
  publishedAt          DateTime @default(now()) @map("published_at")

  @@index([appId, status])
  @@index([projectId])
  @@map("deployment_records")
}

model AppStoreRegistryEntry {
  id                 String   @id
  appId              String   @unique @map("app_id")
  projectId          String   @map("project_id")
  deploymentRecordId String   @unique @map("deployment_record_id")
  slug               String   @unique
  name               String
  route              String
  status             String
  visibility         String
  accessMode         String   @map("access_mode")
  roleKeys           String[] @map("role_keys")
  ownerUserId        String   @map("owner_user_id")
  manifestVersion    String   @map("manifest_version")
  app                App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deploymentRecord   DeploymentRecord @relation(fields: [deploymentRecordId], references: [id], onDelete: Cascade)
  owner              PlatformUser @relation("AppStoreRegistryOwner", fields: [ownerUserId], references: [id])
  publishedAt        DateTime @default(now()) @map("published_at")

  @@index([status])
  @@map("app_store_registry_entries")
}

model SupportTicket {
  id                String   @id
  ticketNumber      String   @unique @map("ticket_number")
  appId             String   @map("app_id")
  appSlug           String   @map("app_slug")
  projectId         String   @map("project_id")
  submittedByUserId String   @map("submitted_by_user_id")
  submittedByEmail  String   @map("submitted_by_email")
  type              String
  priority          String
  title             String
  description       String
  deviceInfo        String   @map("device_info")
  screenshotUrl     String?  @map("screenshot_url")
  status            String
  assignedToUserId  String   @map("assigned_to_user_id")
  app               App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy       PlatformUser @relation("SupportTicketSubmittedBy", fields: [submittedByUserId], references: [id])
  assignedTo        PlatformUser @relation("SupportTicketAssignedTo", fields: [assignedToUserId], references: [id])
  timeline          SupportTicketTimelineEntry[]
  prdChangeRequests PrdChangeRequest[]
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@index([submittedByUserId, createdAt])
  @@map("support_tickets")
}

model SupportTicketTimelineEntry {
  id         String   @id
  ticketId   String   @map("ticket_id")
  status     String
  label      String
  actorUserId String @map("actor_user_id")
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor      PlatformUser @relation("SupportTicketTimelineActor", fields: [actorUserId], references: [id])
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([ticketId, occurredAt])
  @@map("support_ticket_timeline_entries")
}

model InAppNotification {
  id        String   @id
  userId    String   @map("user_id")
  projectId String?  @map("project_id")
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read])
  @@map("in_app_notifications")
}

model PrdChangeRequest {
  id                   String   @id
  projectId            String   @map("project_id")
  sourceType           String   @map("source_type")
  sourceTicketId       String?  @map("source_ticket_id")
  title                String
  proposedRequirement  String   @map("proposed_requirement")
  affectedSections     String[] @map("affected_sections")
  acceptanceCriteria   String[] @map("acceptance_criteria")
  riskLevel            String   @map("risk_level")
  status               String
  requestedByUserId    String   @map("requested_by_user_id")
  approvedPrdVersionId String?  @map("approved_prd_version_id")
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTicket         SupportTicket? @relation(fields: [sourceTicketId], references: [id])
  requestedBy          PlatformUser @relation("PrdChangeRequestedBy", fields: [requestedByUserId], references: [id])
  approvedPrdVersion   PrdVersion? @relation("PrdChangeApprovedVersion", fields: [approvedPrdVersionId], references: [id])
  decisions            PrdChangeDecision[]
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@unique([sourceTicketId])
  @@map("prd_change_requests")
}

model PrdChangeDecision {
  id              String   @id
  changeRequestId String   @map("change_request_id")
  decision        String
  note            String
  decidedByUserId String   @map("decided_by_user_id")
  changeRequest   PrdChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  decidedBy       PlatformUser @relation("PrdChangeDecisionBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime @default(now()) @map("decided_at")

  @@index([changeRequestId, decidedAt])
  @@map("prd_change_decisions")
}

model DomainSetting {
  id           String   @id
  projectId    String   @unique @map("project_id")
  internalPath String   @map("internal_path")
  customDomain String?  @map("custom_domain")
  publicDomain String?  @map("public_domain")
  mode         String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  traceRecords DeploymentTraceRecord[]
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("domain_settings")
}

model DomainRequest {
  id                 String   @id
  projectId          String   @map("project_id")
  domain             String
  reason             String
  intendedAudience   String   @map("intended_audience")
  dataClassification String   @map("data_classification")
  externalUserPolicy String   @map("external_user_policy")
  checklistAccepted  Boolean  @map("checklist_accepted")
  status             String
  requestedByUserId  String   @map("requested_by_user_id")
  decidedByUserId    String?  @map("decided_by_user_id")
  decisionNote       String?  @map("decision_note")
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy        PlatformUser @relation("DomainRequestRequestedBy", fields: [requestedByUserId], references: [id])
  decidedBy          PlatformUser? @relation("DomainRequestDecidedBy", fields: [decidedByUserId], references: [id])
  createdAt          DateTime @default(now()) @map("created_at")
  decidedAt          DateTime? @map("decided_at")

  @@index([projectId, status])
  @@map("domain_requests")
}

model DeploymentTraceRecord {
  id                 String   @id
  projectId          String   @map("project_id")
  ticketId           String   @map("ticket_id")
  prdChangeRequestId String   @map("prd_change_request_id")
  prdVersionId       String   @map("prd_version_id")
  frontendCheckpointId String @map("frontend_checkpoint_id")
  appManifestId      String   @map("app_manifest_id")
  deploymentRecordId String   @map("deployment_record_id")
  domainSettingId    String   @map("domain_setting_id")
  auditEventIds      String[] @map("audit_event_ids")
  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domainSetting      DomainSetting @relation(fields: [domainSettingId], references: [id])
  generatedAt        DateTime @default(now()) @map("generated_at")

  @@index([projectId])
  @@map("deployment_trace_records")
}
