{
  "realm": "evcp",
  "enabled": true,
  "displayName": "Enterprise Vibe Coding Platform",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "groups": [
    { "name": "evcp-admins" },
    { "name": "evcp-creators" },
    { "name": "evcp-users" }
  ],
  "clients": [
    {
      "clientId": "evcp-platform-api",
      "name": "EVCP Platform API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "example-keycloak-platform-client-secret-change-before-use",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3100/auth/keycloak/callback"],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "evcp-admin-web",
      "name": "EVCP Admin Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4100/*"],
      "webOrigins": ["http://localhost:4100"]
    },
    {
      "clientId": "evcp-creator-web",
      "name": "EVCP Creator Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4101/*"],
      "webOrigins": ["http://localhost:4101"]
    },
    {
      "clientId": "evcp-app-store-pwa",
      "name": "EVCP App Store PWA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4102/*"],
      "webOrigins": ["http://localhost:4102"]
    },
    {
      "clientId": "evcp-admin-service",
      "name": "EVCP Admin Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "example-keycloak-admin-client-secret-change-before-use",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "serviceAccountClientRoles": {
        "realm-management": ["query-users", "view-users", "manage-users"]
      }
    }
  ]
}
